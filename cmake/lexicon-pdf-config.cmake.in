@PACKAGE_INIT@

# lexicon-pdf-config.cmake
# Provides the lexicon::pdf imported target.
#
# Usage in a consumer's CMakeLists.txt:
#
#   find_package(lexicon-pdf REQUIRED)
#   target_link_libraries(my_app PRIVATE lexicon::pdf)

include(CMakeFindDependencyMacro)

# Poppler (via poppler-glib) is a private dependency. Consumers linking the
# static archive need it on their own link line; pull it in here.
# NOTE: the module name `Poppler` must match the pkg_check_modules() call in
# the top-level CMakeLists.txt so the imported target PkgConfig::Poppler
# referenced by lexicon-pdf-targets.cmake exists here too.
find_dependency(PkgConfig)
pkg_check_modules(Poppler IMPORTED_TARGET poppler-glib)
if(NOT Poppler_FOUND)
    message(WARNING "lexicon-pdf: could not locate poppler-glib — consumers \
may need to link it manually.")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/lexicon-pdf-targets.cmake")

check_required_components(lexicon-pdf)
